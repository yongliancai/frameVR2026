# 複製成 .env 後修改
PORT=3060
HOST=127.0.0.1

# 用獨立子網域（例如 https://framevr.你的網域/）就留空 ← setup-vps.sh 預設
# 若掛在既有網站的子路徑（例如 https://你的網域/framevr/），填 /framevr 並使用 deploy/nginx-location.conf
BASE_PATH=

# FrameVR 送事件時要帶的金鑰（tracker.js 的 INGEST_KEY 要一致）
# 產生方式：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
INGEST_KEY=請換成一串隨機字

# 後台登入帳密（瀏覽器會跳出登入框）
DASHBOARD_USER=admin
DASHBOARD_PASS=請換成強密碼

# 允許送事件的網站來源，逗號分隔；* 代表全部
ALLOWED_ORIGINS=https://framevr.io,https://www.framevr.io

# 資料庫檔案位置（預設 ./data/framevr.db）
# DB_PATH=/home/你的使用者/framevr-tracker/data/framevr.db

# 後台日期分組用的時區（分鐘），台灣 = 480
TZ_OFFSET_MIN=480
