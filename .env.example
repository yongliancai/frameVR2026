# 複製成 .env 後修改
PORT=3060
HOST=127.0.0.1

# 掛在 https://nckuchat.online/framevr/ 的子路徑；要改的話 deploy.sh 的 HEALTH_URL 與 Vhost 也要一起改
BASE_PATH=/framevr

# FrameVR 送事件時要帶的金鑰（FrameVR「API Keys for Interactivity」新增的那把要一致）
# 產生方式：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
INGEST_KEY=請換成一串隨機字

# 第一個管理者帳號：只在資料庫還沒有任何帳號時使用一次（之後的帳號在後台「帳號與學生」新增）
# 沒填時會沿用舊的 DASHBOARD_USER / DASHBOARD_PASS
ADMIN_USER=admin
ADMIN_PASS=請換成至少10個字元的強密碼
# 登入狀態保留天數
LOGIN_SESSION_DAYS=7

# 允許送事件的網站來源，逗號分隔；* 代表全部（事件 API 已有 INGEST_KEY 保護）
ALLOWED_ORIGINS=*

# 資料庫檔案位置（預設 ./data/framevr.db）
# DB_PATH=/home/你的使用者/framevr-tracker/data/framevr.db

# 後台日期分組用的時區（分鐘），台灣 = 480
TZ_OFFSET_MIN=480

# 同一位學生超過幾分鐘沒有動作，下一個動作就算「新的一次使用」
SESSION_GAP_MIN=15
# 單次教材互動時間上限（分鐘），避免開著不看灌高時間
MAX_MATERIAL_MIN=10
# 「近幾分鐘有動作」視為正在使用（後台總覽的人數）
ONLINE_WINDOW_MIN=5
# 同一位學生在幾毫秒內重複點同一物件只算一次（0 = 不去重）
DEDUPE_MS=1000
# 原始請求紀錄保留筆數
PROBE_KEEP=300
# 1 = 後台的 Action Editor 範本加上 "email": "%email%"（學生第一次觸發時 FrameVR 會詢問是否同意分享 email）
COLLECT_EMAIL=0

# （選用）FrameVR 官方 API：後台「FrameVR 設定 → Frame API 測試」用來讀取物件資料
# FRAME_API_KEY = FrameVR → PROFILE →「Your API Key」（擁有者權限，請勿外流）
FRAME_API_KEY=
FRAME_REF=ncku2026
