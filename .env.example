# 複製成 .env 後修改
PORT=3060
HOST=127.0.0.1

# 掛在 https://nckuchat.online/framevr/ 的子路徑；要改的話 deploy.sh 的 HEALTH_URL 與 Vhost 也要一起改
BASE_PATH=/framevr

# FrameVR 送事件時要帶的金鑰（tracker.js 的 INGEST_KEY 要一致）
# 產生方式：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
INGEST_KEY=請換成一串隨機字

# 後台登入帳密（瀏覽器會跳出登入框）
DASHBOARD_USER=admin
DASHBOARD_PASS=請換成強密碼

# 允許送事件的網站來源，逗號分隔；* 代表全部（事件 API 已有 INGEST_KEY 保護）
ALLOWED_ORIGINS=*

# 資料庫檔案位置（預設 ./data/framevr.db）
# DB_PATH=/home/你的使用者/framevr-tracker/data/framevr.db

# 後台日期分組用的時區（分鐘），台灣 = 480
TZ_OFFSET_MIN=480

# 同一位學生超過幾分鐘沒有動作，下一個動作就算「新的一次使用」
SESSION_GAP_MIN=15
# 單次教材互動時間上限（分鐘），避免開著不看灌高時間
MAX_MATERIAL_MIN=10
# 「近幾分鐘有動作」視為正在使用（後台總覽的人數）
ONLINE_WINDOW_MIN=5
